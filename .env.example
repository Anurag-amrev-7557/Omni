# Enterprise Multi-Document RAG Configuration

# Groq LPU API Key (Required for high-throughput LLM inference)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Optional Cloud Qdrant Configuration (Defaults to embedded local storage at data/qdrant_db)
# QDRANT_URL="https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333"
# QDRANT_API_KEY="your_qdrant_cloud_api_key"

# Optional External Database & Integrations
# NEON_DATABASE_URL="postgresql://user:password@ep-sample.aws.neon.tech/neondb?sslmode=require"
# TAVILY_API_KEY="tvly-your-api-key"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# SUPABASE_STORAGE_BUCKET="documents"
